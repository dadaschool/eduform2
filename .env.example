# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채우세요.
#   cp .env.example .env.local
#
# 같은 값 4개를 Vercel 프로젝트 설정 > Environment Variables 에도 등록해야
# 배포가 성공합니다. 자세한 순서는 SETUP.md 참고.

# Supabase 대시보드 > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 같은 화면 > Project API keys > anon / public
# 브라우저에 노출되는 공개 키입니다. RLS 로 보호됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 같은 화면 > Project API keys > service_role
# RLS 를 무시하는 관리자 키입니다. 절대 클라이언트 코드나 깃에 넣지 마세요.
# 학생 계정 생성 / 비밀번호 초기화 API 에서만 서버 측으로 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (평가 항목 추천 / 생활기록부 초안 생성) ---
# 둘 중 하나만 있어도 동작합니다. Gemini 를 먼저 시도하고 실패하면 업스테이지로 넘어가는데,
# 🔴 업스테이지는 «돈이 나가는» 곳이라 넘어가기 전에 화면에서 한 번 묻습니다.
#    (자세한 내용은 SETUP.md 의 [유료 AI 로 넘어가기 전에 묻는다])

# Google AI Studio (aistudio.google.com/app/apikey) 에서 발급 — 무료 등급
# ⚠ 학교·교육청 계정으로 만든 키는 관리자 정책에 막혀 429 limit:0 이 납니다. 개인 계정으로 만드세요.
GEMINI_API_KEY=

# 업스테이지 콘솔 (console.upstage.ai) 에서 발급
# 🔴 유료입니다 — solar-pro3 : 입력 $0.15 / 출력 $0.60 (100만 토큰당).
#    선불 크레딧이 모자라면 등록된 신용카드로 청구됩니다.
#    요금이 한 푼도 나가면 안 된다면 이 칸을 비워 두세요. AI 버튼 2개만 안 되고 나머지는 다 됩니다.
UPSTAGE_API_KEY=

# 먼저 시도할 쪽. 비우면 gemini 우선.
# ⚠ upstage 로 두면 «유료가 1순위» 라 버튼을 누를 때마다 확인 창이 뜹니다(막히지는 않습니다).
AI_PRIMARY=

# 확인 창 없이 늘 유료를 쓰겠다면 1 로 둡니다. 기본은 꺼짐.
# 🔴 이 값을 켜면 «모르는 사이의 과금» 을 막는 마지막 문이 열립니다. 정말 필요할 때만.
AI_ALLOW_PAID=

# --- 설치용 (선택) ---
# npm run db:setup / db:seed 로 테이블을 자동 생성할 때만 필요합니다.
# Supabase > Project Settings > Database > Connection string > URI 를 복사하고
# [YOUR-PASSWORD] 를 실제 DB 비밀번호로 바꾸세요.
# 앱 실행에는 필요 없고, Vercel 에는 등록하지 않아도 됩니다.
# 비밀번호에 @ : / 가 있으면 URL 인코딩이 필요합니다 (@ 는 %40).
SUPABASE_DB_URL=

# --- 교내 서버(윈도우)로 쓸 때만 ---
# 학교 안 컴퓨터에서 Postgres + PostgREST 로 직접 돌리는 경우입니다.
# 클라우드 Supabase 를 쓰신다면 아래 세 칸은 비워 두세요.
# 값은 `npm run selfhost:keys` 가 한 번에 만들어 줍니다. 절차는 SELFHOST.md.

# PostgREST 의 postgrest.conf 에 적은 jwt-secret 과 «같은 값» 이어야 합니다.
# 어긋나면 화면은 뜨는데 모든 자료 요청이 401 로 떨어집니다.
SUPABASE_JWT_SECRET=

# 로그인 처리(/auth/v1/*)가 쓰는 Postgres 직접 연결.
# 예: postgresql://postgres:비밀번호@127.0.0.1:5432/postgres
AUTH_DB_URL=

# 같은 컴퓨터에서 도는 PostgREST 주소. 이 값이 있으면 /rest/v1/* 를 그쪽으로 넘깁니다.
# 예: http://127.0.0.1:3001
POSTGREST_URL=
