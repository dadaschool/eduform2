# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채우세요.
#   cp .env.example .env.local
#
# 같은 값 4개를 Vercel 프로젝트 설정 > Environment Variables 에도 등록해야
# 배포가 성공합니다. 자세한 순서는 SETUP.md 참고.

# Supabase 대시보드 > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 같은 화면 > Project API keys > anon / public
# 브라우저에 노출되는 공개 키입니다. RLS 로 보호됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 같은 화면 > Project API keys > service_role
# RLS 를 무시하는 관리자 키입니다. 절대 클라이언트 코드나 깃에 넣지 마세요.
# 학생 계정 생성 / 비밀번호 초기화 API 에서만 서버 측으로 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (평가 항목 추천 / 생활기록부 초안 생성) ---
# AI 는 교사가 «내 계정» 화면에서 자기 API 키(업스테이지 / Gemini / OpenAI)를
# 직접 등록해 씁니다. 등록한 키를 순서대로 시도하고, 한 곳에서 할당량이 바닥나거나
# 오류가 나면 다음 키로 넘어갑니다. 학교 공용 키 하나로 운영하지 않습니다.

# 교사가 등록한 키를 DB 에 넣을 때 AES-256-GCM 으로 암호화하는 열쇠입니다.
# 32자 이상 임의 문자열. 교내 서버는 install.ps1 이 자동 생성합니다.
# 이 값을 잃어버리거나 바꾸면 교사들이 등록한 키를 다시 넣어야 합니다.
AI_KEY_SECRET=

# 아래 세 칸은 «관리자 계정 전용» 학교 공용 폴백입니다 (선택).
# 관리자가 자기 키를 등록하지 않아도 점검·시연용으로 쓸 수 있게만 열어 둡니다.
# 일반 교사에게는 적용되지 않습니다. 비워 두면 관리자도 «내 계정» 에서 등록해야 합니다.
GEMINI_API_KEY=
UPSTAGE_API_KEY=
OPENAI_API_KEY=

# --- 학교 로컬 모델(LM Studio) — 이 서버 컴퓨터에서 직접 도는 경우만 (선택) ---
# 위 세 칸과 달리 «관리자 전용» 이 아니다 — 계정별 할당량도 청구서도 없는
# 로컬 모델이라 교사 전원에게 자동으로 폴백에 추가된다.
# 클라우드(Vercel)로 배포하면 이 서버가 학교 PC 의 localhost 에 닿을 수 없어
# 무의미하다 — 앱과 LM Studio 가 «같은 컴퓨터» 에서 돌 때만 쓴다.
#
# 1. LM Studio 에서 모델을 내려받고 로드한 뒤 로컬 서버를 켠다
#    (lms server start && lms load <모델 경로>, 또는 앱의 Local Server 탭)
# 2. 아래 LMSTUDIO_MODEL 에 `lms ls` 로 본 모델 식별자를 그대로 적는다
#    예: qwen/qwen3-4b-2507
LMSTUDIO_MODEL=
# 기본값 http://127.0.0.1:1234/v1 — 포트를 바꿨을 때만 채운다.
LMSTUDIO_URL=

# --- 설치용 (선택) ---
# npm run db:setup / db:seed 로 테이블을 자동 생성할 때만 필요합니다.
# Supabase > Project Settings > Database > Connection string > URI 를 복사하고
# [YOUR-PASSWORD] 를 실제 DB 비밀번호로 바꾸세요.
# 앱 실행에는 필요 없고, Vercel 에는 등록하지 않아도 됩니다.
# 비밀번호에 @ : / 가 있으면 URL 인코딩이 필요합니다 (@ 는 %40).
SUPABASE_DB_URL=

# --- 교내 서버(윈도우)로 쓸 때만 ---
# 학교 안 컴퓨터에서 Postgres + PostgREST 로 직접 돌리는 경우입니다.
# 클라우드 Supabase 를 쓰신다면 아래 세 칸은 비워 두세요.
# 값은 `npm run selfhost:keys` 가 한 번에 만들어 줍니다. 절차는 SELFHOST.md.

# PostgREST 의 postgrest.conf 에 적은 jwt-secret 과 «같은 값» 이어야 합니다.
# 어긋나면 화면은 뜨는데 모든 자료 요청이 401 로 떨어집니다.
SUPABASE_JWT_SECRET=

# 로그인 처리(/auth/v1/*)가 쓰는 Postgres 직접 연결.
# 예: postgresql://postgres:비밀번호@127.0.0.1:5432/postgres
AUTH_DB_URL=

# 같은 컴퓨터에서 도는 PostgREST 주소. 이 값이 있으면 /rest/v1/* 를 그쪽으로 넘깁니다.
# 예: http://127.0.0.1:3001
POSTGREST_URL=
